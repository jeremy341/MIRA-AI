    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "packageManager": "pnpm@11.21.0"
}
