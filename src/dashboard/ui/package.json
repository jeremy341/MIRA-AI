{
  "name": "mira-dashboard-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MIRA dashboard v2 UI shell (Svelte 5 + Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
