# --- IDE / OS ---
.idea/
.DS_Store
.vscode/
Thumbs.db
*.swp
*.swo
*~

# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.hypothesis/
*.cache

# --- Build artifacts (python -m build) ---
build/
dist/

# --- Archives ---
archive/

# --- Datasets (downloaded data is too large for git) ---
datasets/*
!datasets/registry/
!datasets/registry/*.yaml

# --- Training outputs ---
runs/

# --- Trained model files (only YAML descriptors are tracked, not binaries) ---
models/classifier/
models/detection/*.pt
models/detection/*.tflite
models/detection/*.onnx
!models/detection/*.yaml
*.npy

# --- YOLO weights and large model files in results ---
results/**/weights/
results/**/*.pt
results/**/*.onnx
results/**/*.tflite

# --- JuFo LaTeX (local build, not tracked) ---
jufo/latex/
jufo/Stardance_Progress_Report.md
jufo/

# --- Large archives ---
*.zip
*.tar.gz

# --- Secrets / Environment ---
.env
.env.*
*.key
*.pem
secrets.*
credentials.*
config.local.*

# --- Experiment results (regenerable plots, CSVs, args) ---
results/
!results/experiments_log.md

# --- EXP020 (local runbook + script, not tracked) ---
docs/EXP020_RUNBOOK.md
scripts/run_exp020.py

# --- CLAUDE AI context (private) ---
CLAUDE/
memory.md
